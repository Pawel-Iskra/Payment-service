pipeline {
    agent {
        label 'payment-service-agent'
    }


    stages {

        stage('Checkout') {
            steps {
                git branch: 'master',
                    url: 'https://github.com/Pawel-Iskra/Payment-service.git'
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean compile'
            }
        }

        stage('Unit & Integration Tests') {
            steps {
                sh 'mvn test'
            }
        }

        stage('E2E Tests') {
            steps {
                sh 'mvn test-compile failsafe:integration-test failsafe:verify'
            }
        }

        stage('Coverage') {
            steps {
                sh 'mvn jacoco:report'
                sh 'mvn jacoco:check@check-coverage'
            }
        }

        stage('Package') {
            steps {
                sh 'mvn package -DskipTests'
            }
        }

        stage('Docker Image') {
            steps {
                sh 'docker build -f dockerfile-payment-service -t payment-service:${BUILD_NUMBER} -t payment-service:latest .'
            }
        }
    }

    post {
            always {
                junit '**/target/surefire-reports/*.xml'
                junit '**/target/failsafe-reports/*.xml'

                recordCoverage(
                    tools: [[
                        parser: 'JACOCO',
                        pattern: '**/target/site/jacoco/jacoco.xml'
                    ]]
                )
            }

            success {
                archiveArtifacts artifacts: 'target/*.jar',
                                 fingerprint: true
            }
    }

}