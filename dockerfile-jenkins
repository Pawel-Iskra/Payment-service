# creation of jenkins agent
FROM jenkins/inbound-agent:jdk25

USER root

# preparing jenkins agent tools
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        maven \
        git \
        curl \
        ca-certificates \
        openssh-client && \
    rm -rf /var/lib/apt/lists/*

# switch from root to user jenkins
USER jenkins

# set agent workspace
WORKDIR /home/jenkins/agent