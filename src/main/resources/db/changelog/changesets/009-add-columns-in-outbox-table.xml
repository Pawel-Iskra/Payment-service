<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">


    <changeSet id="009" author="xyz">
        <addColumn tableName="outbox_event">
            <column name="attempt_count" type="smallint" defaultValueComputed="0">
                <constraints nullable="false"/>
                </column>
            <column name="last_error" type="varchar(256)"/>
            <column name="failed_at" type="timestamp(6) with time zone"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>