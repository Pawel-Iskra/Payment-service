<?xml version="1.0" encoding="UTF-8"?>
<xs:schema
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns="urn:iso:std:iso:20022:tech:xsd:pain.001.001.12"
    targetNamespace="urn:iso:std:iso:20022:tech:xsd:pain.001.001.12"
    elementFormDefault="qualified">

    <!--
      The input contract file for this Payment Service.
      This is intentionally narrower than the official ISO XSD.
      It models one payment instruction with exactly one credit transfer.
      It does NOT claim full ISO 20022 or EPC business-rule conformance.
    -->

    <xs:element name="Document" type="DocumentType"/>

    <xs:complexType name="DocumentType">
        <xs:sequence>
            <xs:element name="CstmrCdtTrfInitn" type="CustomerCreditTransferInitiationType"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="CustomerCreditTransferInitiationType">
        <xs:sequence>
            <xs:element name="GrpHdr" type="GroupHeaderType"/>
            <xs:element name="PmtInf" type="PaymentInstructionType"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="GroupHeaderType">
        <xs:sequence>
            <xs:element name="MsgId" type="Max35Text"/>
            <xs:element name="CreDtTm" type="xs:dateTime"/>
            <xs:element name="NbOfTxs" type="SingleTransactionCount"/>
            <xs:element name="CtrlSum" type="AmountNumber"/>
            <xs:element name="InitgPty" type="PartyNameType"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="PaymentInstructionType">
        <xs:sequence>
            <xs:element name="PmtInfId" type="Max35Text"/>
            <xs:element name="PmtMtd" fixed="TRF">
                <xs:simpleType>
                    <xs:restriction base="xs:string">
                        <xs:enumeration value="TRF"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="NbOfTxs" type="SingleTransactionCount"/>
            <xs:element name="CtrlSum" type="AmountNumber"/>
            <xs:element name="PmtTpInf" type="PaymentTypeInformationType"/>
            <xs:element name="ReqdExctnDt" type="RequiredExecutionDateType"/>
            <xs:element name="Dbtr" type="PartyNameType"/>
            <xs:element name="DbtrAcct" type="AccountType"/>
            <xs:element name="DbtrAgt" type="AgentType"/>
            <xs:element name="ChrgBr" fixed="SLEV">
                <xs:simpleType>
                    <xs:restriction base="xs:string">
                        <xs:enumeration value="SLEV"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="CdtTrfTxInf" type="CreditTransferTransactionType"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="PaymentTypeInformationType">
        <xs:sequence>
            <xs:element name="SvcLvl">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="Cd" fixed="SEPA">
                            <xs:simpleType>
                                <xs:restriction base="xs:string">
                                    <xs:enumeration value="SEPA"/>
                                </xs:restriction>
                            </xs:simpleType>
                        </xs:element>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="RequiredExecutionDateType">
        <xs:sequence>
            <xs:element name="Dt" type="xs:date"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="PartyNameType">
        <xs:sequence>
            <xs:element name="Nm" type="Max70Text"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="AccountType">
        <xs:sequence>
            <xs:element name="Id">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="IBAN" type="IBANType"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="AgentType">
        <xs:sequence>
            <xs:element name="FinInstnId">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="BICFI" type="BICType"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="CreditTransferTransactionType">
        <xs:sequence>
            <xs:element name="PmtId">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="EndToEndId" type="Max35Text"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="Amt">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="InstdAmt" type="InstructedAmountType"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="CdtrAgt" type="AgentType"/>
            <xs:element name="Cdtr" type="PartyNameType"/>
            <xs:element name="CdtrAcct" type="AccountType"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="InstructedAmountType">
        <xs:simpleContent>
            <xs:extension base="AmountNumber">
                <xs:attribute name="Ccy" type="CurrencyCode" use="required"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <xs:simpleType name="Max35Text">
        <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="35"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="Max70Text">
        <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="70"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="SingleTransactionCount">
        <xs:restriction base="xs:string">
            <xs:enumeration value="1"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="AmountNumber">
        <xs:restriction base="xs:decimal">
            <xs:minExclusive value="0"/>
            <xs:totalDigits value="18"/>
            <xs:fractionDigits value="5"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="CurrencyCode">
        <xs:restriction base="xs:string">
            <xs:pattern value="[A-Z]{3}"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="IBANType">
        <xs:restriction base="xs:string">
            <xs:pattern value="[A-Z]{2}[0-9]{2}[A-Z0-9]{11,30}"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="BICType">
        <xs:restriction base="xs:string">
            <xs:pattern value="[A-Z0-9]{8}([A-Z0-9]{3})?"/>
        </xs:restriction>
    </xs:simpleType>

</xs:schema>
